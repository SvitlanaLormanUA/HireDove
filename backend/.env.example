ENVIRONMENT=development
# Leave empty locally to use SQLite. In production use the Postgres URL from Neon/Render.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:5173

# Critical moderation emails: console suppresses delivery and logs no private payload.
EMAIL_MODE=console
# Set EMAIL_MODE=smtp to enable real delivery (credentials stay in local environment).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true

# Development-only admin seed; supply a private password before first execution.
DEV_ADMIN_EMAIL=admin.demo@example.com
# DEV_ADMIN_PASSWORD=
